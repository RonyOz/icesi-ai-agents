---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentCard from '../components/AgentCard.astro';
import Cenefa from '../components/Cenefa.astro';
import { getAllAgents } from '../lib/db';

const agents = await getAllAgents();
---

<BaseLayout count={agents.length}>
  <section class="mb-14 sm:mb-16 max-w-3xl">
    <p class="eyebrow mb-5">Showcase de Proyectos · IA</p>
    <h1 class="text-[2.4rem] sm:text-[3.25rem] font-extrabold leading-[1.05] tracking-tight text-text">
      Agentes de IA en desarrollo
      <span class="text-icesi-purple">en Icesi</span>.
    </h1>
    <p class="mt-6 text-lg text-muted leading-relaxed">
      Iniciativas activas que aplican inteligencia artificial a desafíos reales
      de organizaciones, lideradas por equipos de la Universidad Icesi.
    </p>
    <div class="mt-7">
      <Cenefa />
    </div>
  </section>

  <ul
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border border border-border"
    role="list"
    aria-label="Agentes en desarrollo"
  >
    {agents.map((agent) => (
      <li class="bg-(--color-surface)">
        <AgentCard
          slug={agent.slug}
          name={agent.name}
          summary={agent.summary}
          videoUrl={agent.video_url ?? undefined}
          videoLocal={agent.video_local ?? undefined}
          cover={agent.cover ?? undefined}
        />
      </li>
    ))}
  </ul>
</BaseLayout>
