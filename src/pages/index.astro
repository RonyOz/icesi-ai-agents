---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentCard from '../components/AgentCard.astro';
import Cenefa from '../components/Cenefa.astro';
import { getAllAgents } from '../lib/db';

const agents = await getAllAgents();

const areas = Array.from(
  new Set(agents.map((a) => a.area).filter((a): a is string => Boolean(a))),
).sort((a, b) => a.localeCompare(b, 'es'));
---

<BaseLayout count={agents.length}>
  <section class="mb-12 sm:mb-14 max-w-3xl">
    <p class="eyebrow mb-5">Showcase de Proyectos · IA</p>
    <h1 class="text-[2.4rem] sm:text-[3.25rem] font-extrabold leading-[1.05] tracking-tight text-text">
      Agentes de IA en desarrollo
      <span class="text-icesi-purple">en Icesi</span>.
    </h1>
    <p class="mt-6 text-lg text-muted leading-relaxed">
      Iniciativas activas que aplican inteligencia artificial a desafíos reales
      de organizaciones, lideradas por equipos de la Universidad Icesi.
    </p>
    <div class="mt-7">
      <Cenefa />
    </div>
  </section>

  {agents.length > 0 && (
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="relative flex-1 max-w-md">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 text-muted"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <label for="public-search" class="sr-only">Buscar agente</label>
        <input
          type="search"
          id="public-search"
          placeholder="Buscar por nombre, encargado o área…"
          autocomplete="off"
          class="w-full rounded-lg border-[1.5px] border-border bg-white pl-9 pr-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
        />
      </div>

      {areas.length > 0 && (
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filtrar por área">
          <button
            type="button"
            class="js-public-chip rounded-full border border-icesi-blue bg-icesi-blue px-3 py-1 text-xs font-semibold text-white"
            data-area=""
            aria-pressed="true"
          >
            Todas
          </button>
          {areas.map((area) => (
            <button
              type="button"
              class="js-public-chip rounded-full border border-border bg-white px-3 py-1 text-xs font-semibold text-muted hover:border-icesi-blue/40 hover:text-icesi-blue-deep transition-colors"
              data-area={area}
              aria-pressed="false"
            >
              {area}
            </button>
          ))}
        </div>
      )}
    </div>
  )}

  <ul
    id="public-grid"
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border border border-border"
    role="list"
    aria-label="Agentes en desarrollo"
  >
    {agents.map((agent) => (
      <li class="bg-(--color-surface)">
        <AgentCard
          slug={agent.slug}
          name={agent.name}
          summary={agent.summary}
          area={agent.area}
          encargado={agent.encargado}
          videoUrl={agent.video_url ?? undefined}
          cover={agent.cover ?? undefined}
        />
      </li>
    ))}
  </ul>

  <div
    id="public-empty"
    class="hidden mt-10 text-center py-12 px-6 border border-dashed border-border rounded-lg"
  >
    <p class="text-base font-semibold text-text">Sin resultados</p>
    <p class="text-sm text-muted mt-1">Probá con otros términos o área.</p>
  </div>
</BaseLayout>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;
  const $$ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    Array.from(document.querySelectorAll<T>(sel));

  const searchInput = $<HTMLInputElement>('public-search');
  const grid = $('public-grid');
  const emptyState = $('public-empty');
  if (!grid) throw new Error('public-grid missing');

  const state = { search: '', area: '' };

  function apply() {
    const items = Array.from(grid!.querySelectorAll<HTMLLIElement>('li'));
    const q = state.search.toLowerCase();
    const area = state.area;
    let visible = 0;

    for (const li of items) {
      const card = li.querySelector<HTMLElement>('.js-public-card');
      if (!card) continue;
      const matchesSearch =
        !q ||
        (card.dataset.nameSearch ?? '').includes(q) ||
        (card.dataset.summarySearch ?? '').includes(q) ||
        (card.dataset.encargadoSearch ?? '').includes(q) ||
        (card.dataset.areaSearch ?? '').includes(q);
      const matchesArea = !area || card.dataset.area === area;
      const show = matchesSearch && matchesArea;
      li.style.display = show ? '' : 'none';
      if (show) visible++;
    }

    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }
  }

  searchInput?.addEventListener('input', () => {
    state.search = searchInput.value.trim();
    apply();
  });

  document.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('.js-public-chip');
    if (!chip) return;
    state.area = chip.dataset.area ?? '';
    $$('.js-public-chip').forEach((c) => {
      const active = c === chip;
      c.setAttribute('aria-pressed', String(active));
      c.classList.toggle('bg-icesi-blue', active);
      c.classList.toggle('text-white', active);
      c.classList.toggle('border-icesi-blue', active);
      c.classList.toggle('bg-white', !active);
      c.classList.toggle('text-muted', !active);
      c.classList.toggle('border-border', !active);
    });
    apply();
  });
</script>
