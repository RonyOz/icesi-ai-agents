---
const title = 'Dashboard · Admin';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard · Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --font-sans: "Plus Jakarta Sans", sans-serif;
        --color-icesi-blue: #5454e9;
        --color-icesi-blue-deep: #2d2d9c;
        --color-text: #14161c;
        --color-muted: #4b5160;
        --color-bg: #f6f6f9;
        --color-surface: #ffffff;
        --color-border: #e4e4ea;
        --color-icesi-red: #dc2626;
        --color-icesi-green: #16a34a;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        min-height: 100vh;
      }
      .skip-link {
        position: absolute;
        top: -100%;
        left: 1rem;
        padding: 0.5rem 1rem;
        background: var(--color-icesi-blue);
        color: white;
        border-radius: 0 0 8px 8px;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        z-index: 9999;
        transition: top 0.15s;
      }
      .skip-link:focus { top: 0; }
      .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
      .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap; }
      .header h1 { font-size: 1.75rem; font-weight: 800; }
      .header-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
      .btn { padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600; cursor: pointer; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 0.375rem; transition: background-color 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s; }
      .btn:focus-visible { outline: 2px solid var(--color-icesi-blue); outline-offset: 2px; }
      .btn-primary { background: var(--color-icesi-blue); color: white; }
      .btn-primary:hover { background: var(--color-icesi-blue-deep); }
      .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
      .btn-ghost { background: transparent; color: var(--color-muted); border: 1px solid var(--color-border); }
      .btn-ghost:hover { background: #f3f4f6; }
      .btn-danger { background: #fef2f2; color: var(--color-icesi-red); border: 1px solid #fecaca; }
      .btn-danger:hover { background: #fee2e2; }
      .btn-close { background: none; border: none; cursor: pointer; font-size: 1.5rem; line-height: 1; color: var(--color-muted); padding: 0.25rem; border-radius: 4px; }
      .btn-close:hover { background: #f3f4f6; }
      .btn-close:focus-visible { outline: 2px solid var(--color-icesi-blue); outline-offset: 2px; }
      .card { background: var(--color-surface); border-radius: 12px; border: 1px solid var(--color-border); overflow: hidden; }
      table { width: 100%; border-collapse: collapse; }
      thead { background: #f9fafb; }
      th { text-align: left; padding: 0.875rem 1rem; font-size: 0.75rem; font-weight: 600; color: var(--color-muted); letter-spacing: 0.05em; text-transform: uppercase; border-bottom: 1px solid var(--color-border); }
      td { padding: 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; vertical-align: middle; }
      tr:last-child td { border-bottom: none; }
      tr:hover td { background: #fafafa; }
      .name-cell { font-weight: 600; }
      .actions { display: flex; gap: 0.5rem; }
      .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem; overscroll-behavior: contain; }
      .modal { background: var(--color-surface); border-radius: 16px; width: 100%; max-width: 640px; max-height: 90vh; overflow-y: auto; }
      .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.5rem; border-bottom: 1px solid var(--color-border); }
      .modal-header h2 { font-size: 1.2rem; font-weight: 700; }
      .modal-body { padding: 1.5rem; }
      .modal-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--color-border); display: flex; justify-content: flex-end; gap: 0.75rem; }
      .form-group { margin-bottom: 1.25rem; }
      .form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.375rem; }
      .form-group input, .form-group textarea { width: 100%; padding: 0.625rem 0.875rem; border: 1.5px solid var(--color-border); border-radius: 8px; font-size: 0.9rem; font-family: inherit; background: white; }
      .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--color-icesi-blue); box-shadow: 0 0 0 3px rgba(84,84,233,0.1); }
      .form-group textarea { resize: vertical; min-height: 100px; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .form-hint { font-size: 0.75rem; color: var(--color-muted); margin-top: 0.25rem; }
      .form-error { font-size: 0.75rem; color: var(--color-icesi-red); margin-top: 0.25rem; display: none; }
      .form-error.show { display: block; }
      .empty-state { text-align: center; padding: 4rem 2rem; color: var(--color-muted); }
      .loading { display: flex; align-items: center; justify-content: center; padding: 4rem; color: var(--color-muted); }
      .loading-spinner { width: 20px; height: 20px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite; display: none; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .toast { position: fixed; bottom: 1.5rem; right: 1.5rem; padding: 0.875rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 500; z-index: 2000; transform: translateY(0); opacity: 1; transition: transform 0.2s, opacity 0.2s; }
      .toast[aria-hidden="true"] { transform: translateY(1rem); opacity: 0; pointer-events: none; }
      .toast-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
      .toast-error { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
      @media (prefers-reduced-motion: reduce) { .toast, .loading-spinner { transition: none; } }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <div class="container">
      <div class="header">
        <h1>Agentes de IA</h1>
        <div class="header-actions">
          <a href="/" class="btn btn-ghost">Ver sitio</a>
          <button class="btn btn-ghost" id="logout-btn" type="button">Cerrar sesi\u00f3n</button>
          <button class="btn btn-primary" id="new-agent-btn" type="button">+ Nuevo agente</button>
        </div>
      </div>

      <div class="card" id="main-content" role="region" aria-label="Lista de agentes">
        <div id="loading" class="loading" aria-live="polite">
          <span>Cargando agentes\u2026</span>
        </div>
        <div id="empty" class="empty-state" style="display:none;" aria-live="polite">
          <p style="font-size:1.1rem;margin-bottom:0.5rem;">No hay agentes cargados.</p>
          <p style="font-size:0.875rem;">Hac\u00e9 clic en &ldquo;Nuevo agente&rdquo; para crear el primero.</p>
        </div>
        <div id="table-container" style="display:none;">
          <table>
            <caption class="sr-only">Agentes de IA</caption>
            <thead>
              <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Resumen</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <tbody id="agents-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="modal-overlay" class="modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal">
        <div class="modal-header">
          <h2 id="modal-title">Nuevo agente</h2>
          <button class="btn-close" id="modal-close-btn" type="button" aria-label="Cerrar">&times;</button>
        </div>
        <form id="agent-form">
          <div class="modal-body">
            <input type="hidden" id="agent-id" name="agent-id" />
            <div class="form-group">
              <label for="agent-slug">Slug <span aria-hidden="true">*</span></label>
              <span class="form-hint">URL: /agents/[slug]/</span>
              <input type="text" id="agent-slug" name="slug" required placeholder="mi-nuevo-agente" autocomplete="off" spellcheck="false" />
              <p class="form-error" id="slug-error" role="alert"></p>
            </div>
            <div class="form-group">
              <label for="agent-name">Nombre <span aria-hidden="true">*</span></label>
              <input type="text" id="agent-name" name="name" required placeholder="Agente consultor de\u2026" autocomplete="off" />
              <p class="form-error" id="name-error" role="alert"></p>
            </div>
            <div class="form-group">
              <label for="agent-summary">Resumen <span aria-hidden="true">*</span></label>
              <input type="text" id="agent-summary" name="summary" required placeholder="Breve descripci\u00f3n del agente" autocomplete="off" />
              <p class="form-error" id="summary-error" role="alert"></p>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="agent-video-url">Video URL</label>
                <input type="url" id="agent-video-url" name="video_url" placeholder="https://youtube.com/\u2026" autocomplete="off" />
              </div>
              <div class="form-group">
                <label for="agent-video-local">Video Local</label>
                <input type="text" id="agent-video-local" name="video_local" placeholder="/videos/nombre.mp4" autocomplete="off" />
              </div>
            </div>
            <div class="form-group">
              <label for="agent-cover">Cover (ruta imagen)</label>
              <input type="text" id="agent-cover" name="cover" placeholder="/images/cover.jpg" autocomplete="off" />
            </div>
            <div class="form-group">
              <label for="agent-team">Equipo</label>
              <input type="text" id="agent-team" name="team" placeholder="Juan P\u00e9rez, Mar\u00eda Garc\u00eda" autocomplete="off" />
              <p class="form-hint">Separar nombres con comas.</p>
            </div>
            <div class="form-group">
              <label for="agent-description">Descripci\u00f3n</label>
              <textarea id="agent-description" name="description" placeholder="Descripci\u00f3n detallada del agente\u2026" rows="4"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-ghost" id="cancel-btn">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="modal-save-btn">
              <span id="save-btn-text">Guardar</span>
              <span id="save-btn-spinner" class="loading-spinner" aria-hidden="true"></span>
            </button>
            <button type="button" class="btn btn-danger" id="modal-delete-btn" style="display:none;">Eliminar</button>
          </div>
        </form>
      </div>
    </div>

    <div id="toast" class="toast" aria-live="polite" aria-hidden="true" role="status"></div>

    <script is:inline>
      (function() {
        var agents = [];

        function esc(s) {
          if (s == null) return '';
          return String(s)
            .replace(/&/g, '&')
            .replace(/</g, '<')
            .replace(/>/g, '>')
            .replace(/"/g, '"')
            .replace(/'/g, ''')
            .replace(/\r?\n/g, ' ')
            .replace(/\t/g, ' ');
        }

        function showToast(msg, type) {
          var el = document.getElementById('toast');
          el.textContent = msg;
          el.className = 'toast toast-' + type;
          el.setAttribute('aria-hidden', 'false');
          setTimeout(function() { el.setAttribute('aria-hidden', 'true'); }, 3000);
        }

        function clearErrors() {
          var errs = document.querySelectorAll('.form-error');
          for (var i = 0; i < errs.length; i++) {
            errs[i].classList.remove('show');
            errs[i].textContent = '';
          }
        }

        function showFieldError(id, msg) {
          var el = document.getElementById(id);
          el.textContent = msg;
          el.classList.add('show');
        }

        function openCreateModal() {
          document.getElementById('modal-title').textContent = 'Nuevo agente';
          document.getElementById('agent-form').reset();
          document.getElementById('agent-id').value = '';
          document.getElementById('agent-slug').removeAttribute('readonly');
          document.getElementById('modal-delete-btn').style.display = 'none';
          clearErrors();
          document.getElementById('modal-overlay').style.display = 'flex';
          document.getElementById('agent-slug').focus();
        }

        function openEditModal(slug) {
          var a = null;
          for (var i = 0; i < agents.length; i++) {
            if (agents[i].slug === slug) { a = agents[i]; break; }
          }
          if (!a) return;
          document.getElementById('modal-title').textContent = 'Editar agente';
          document.getElementById('agent-id').value = a.slug;
          document.getElementById('agent-slug').value = a.slug;
          document.getElementById('agent-slug').setAttribute('readonly', 'true');
          document.getElementById('agent-name').value = a.name;
          document.getElementById('agent-summary').value = a.summary;
          document.getElementById('agent-video-url').value = a.video_url || '';
          document.getElementById('agent-video-local').value = a.video_local || '';
          document.getElementById('agent-cover').value = a.cover || '';
          try { document.getElementById('agent-team').value = JSON.parse(a.team).join(', '); }
          catch (e) { document.getElementById('agent-team').value = ''; }
          document.getElementById('agent-description').value = a.description || '';
          document.getElementById('modal-delete-btn').style.display = 'inline-flex';
          clearErrors();
          document.getElementById('modal-overlay').style.display = 'flex';
          document.getElementById('agent-name').focus();
        }

        function closeModal() {
          document.getElementById('modal-overlay').style.display = 'none';
        }

        async function loadAgents() {
          document.getElementById('loading').style.display = 'flex';
          try {
            var res = await fetch('/api/agents', { credentials: 'same-origin' });
            if (!res.ok) { window.location.href = '/admin/login'; return; }
            agents = await res.json();
            renderTable();
          } catch (err) {
            document.getElementById('loading').textContent = 'Error al cargar agentes. Recarg\u00e1 la p\u00e1gina.';
          }
        }

        function renderTable() {
          document.getElementById('loading').style.display = 'none';
          if (agents.length === 0) {
            document.getElementById('empty').style.display = 'block';
            return;
          }
          document.getElementById('table-container').style.display = 'block';
          var tbody = document.getElementById('agents-tbody');
          var html = '';
          for (var i = 0; i < agents.length; i++) {
            var a = agents[i];
            html += '<tr>' +
              '<td class="name-cell">' + esc(a.name) + '</td>' +
              '<td style="color:var(--color-muted);font-size:0.85rem;">' + esc(a.summary) + '</td>' +
              '<td>' +
                '<div class="actions">' +
                  '<button type="button" class="btn btn-ghost btn-edit" data-slug="' + esc(a.slug) + '" data-name="' + esc(a.name) + '">Editar</button>' +
                '</div>' +
              '</td>' +
            '</tr>';
          }
          tbody.innerHTML = html;
        }

        function handleFormSubmit(e) {
          e.preventDefault();
          clearErrors();
          var slug = document.getElementById('agent-slug').value.trim();
          var name = document.getElementById('agent-name').value.trim();
          var summary = document.getElementById('agent-summary').value.trim();
          var hasError = false;
          if (!slug) { showFieldError('slug-error', 'El slug es obligatorio'); hasError = true; }
          if (!name) { showFieldError('name-error', 'El nombre es obligatorio'); hasError = true; }
          if (!summary) { showFieldError('summary-error', 'El resumen es obligatorio'); hasError = true; }
          if (hasError) return;
          saveAgent();
        }

        async function saveAgent() {
          var saveBtn = document.getElementById('modal-save-btn');
          var btnText = document.getElementById('save-btn-text');
          var spinner = document.getElementById('save-btn-spinner');
          saveBtn.disabled = true;
          btnText.textContent = 'Guardando\u2026';
          spinner.style.display = 'inline-block';

          var slug = document.getElementById('agent-slug').value.trim();
          var name = document.getElementById('agent-name').value.trim();
          var summary = document.getElementById('agent-summary').value.trim();
          var teamStr = document.getElementById('agent-team').value.trim();
          var teamJson = JSON.stringify(
            teamStr ? teamStr.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : []
          );

          var body = {
            slug: slug,
            name: name,
            summary: summary,
            description: document.getElementById('agent-description').value.trim(),
            team: teamJson,
            video_url: document.getElementById('agent-video-url').value.trim() || null,
            video_local: document.getElementById('agent-video-local').value.trim() || null,
            cover: document.getElementById('agent-cover').value.trim() || null,
          };

          var idField = document.getElementById('agent-id').value;
          var isEdit = Boolean(idField);
          var url = isEdit ? '/api/agents/' + encodeURIComponent(idField) : '/api/agents';
          var method = isEdit ? 'PUT' : 'POST';

          try {
            var res = await fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify(body),
            });

            if (res.ok) {
              closeModal();
              showToast(isEdit ? 'Agente actualizado' : 'Agente creado', 'success');
              loadAgents();
            } else {
              var err = await res.json();
              showToast(err.error || 'Error al guardar', 'error');
              saveBtn.disabled = false;
              btnText.textContent = 'Guardar';
              spinner.style.display = 'none';
            }
          } catch (err) {
            showToast('Error de conexi\u00f3n', 'error');
            saveBtn.disabled = false;
            btnText.textContent = 'Guardar';
            spinner.style.display = 'none';
          }
        }

        function handleDelete() {
          if (!window.confirm('\u00bfEst\u00e1s seguro de eliminar este agente?')) return;
          var slug = document.getElementById('agent-id').value;
          fetch('/api/agents/' + encodeURIComponent(slug), {
            method: 'DELETE',
            credentials: 'same-origin',
          }).then(function(res) {
            if (res.ok) {
              closeModal();
              showToast('Agente eliminado', 'success');
              loadAgents();
            } else {
              res.json().then(function(err) {
                showToast(err.error || 'Error al eliminar', 'error');
              });
            }
          }).catch(function() {
            showToast('Error de conexi\u00f3n', 'error');
          });
        }

        // Event delegation on document
        document.addEventListener('click', function(e) {
          var target = e.target;
          var editBtn = target.closest('.btn-edit');
          if (editBtn) {
            openEditModal(editBtn.getAttribute('data-slug'));
            return;
          }
          if (target.closest('#new-agent-btn')) {
            openCreateModal();
            return;
          }
          if (target.closest('#logout-btn')) {
            fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' })
              .then(function() { window.location.href = '/admin/login'; });
            return;
          }
          if (target.closest('#modal-close-btn') || target.closest('#cancel-btn')) {
            closeModal();
            return;
          }
          if (target.closest('#modal-delete-btn')) {
            handleDelete();
            return;
          }
          var overlay = document.getElementById('modal-overlay');
          if (target === overlay) {
            closeModal();
          }
        }, false);

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            closeModal();
          }
        }, false);

        document.getElementById('agent-form').addEventListener('submit', handleFormSubmit);

        loadAgents();
      })();
    </script>
  </body>
</html>