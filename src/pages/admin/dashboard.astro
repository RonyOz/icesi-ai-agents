---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AgentTable from '../../components/admin/AgentTable.astro';
import AgentFormModal from '../../components/admin/AgentFormModal.astro';
import { getAllAgents } from '../../lib/db';

let agents = await getAllAgents().catch((err) => {
  console.error('[admin/dashboard] getAllAgents failed', err);
  return null;
});

const loadError = agents === null;
agents ??= [];
---

<AdminLayout title="Dashboard · Admin">
  <a href="#main-content" class="skip-link">Saltar al contenido</a>

  <div class="admin-container">
    <div class="admin-header">
      <h1>Agentes de IA</h1>
      <div class="admin-header-actions">
        <a href="/" class="btn btn-ghost">Ver sitio</a>
        <button class="btn btn-ghost" id="logout-btn" type="button">Cerrar sesión</button>
        <button class="btn btn-primary" id="new-agent-btn" type="button">+ Nuevo agente</button>
      </div>
    </div>

    {loadError && (
      <div class="card" style="padding:1rem;margin-bottom:1rem;background:#fef2f2;border-color:#fecaca;color:#991b1b;">
        Error al cargar agentes desde la base de datos. Revisá las variables de entorno
        <code>TURSO_DATABASE_URL</code> y <code>TURSO_AUTH_TOKEN</code>.
      </div>
    )}

    <div class="card" id="main-content" role="region" aria-label="Lista de agentes">
      <AgentTable agents={agents} />
    </div>
  </div>

  <AgentFormModal />

  <div id="toast" class="toast" aria-live="polite" aria-hidden="true" role="status"></div>
</AdminLayout>

<script>
  type AgentRow = {
    id: string;
    slug: string;
    name: string;
    summary: string;
    description: string;
    team: string[];
    video_url: string | null;
    video_local: string | null;
    cover: string | null;
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  function getAgentFromRow(slug: string): AgentRow | null {
    const tr = document.querySelector<HTMLTableRowElement>(`tr[data-agent] .btn-edit[data-slug="${CSS.escape(slug)}"]`)
      ?.closest('tr');
    if (!tr?.dataset.agent) return null;
    try { return JSON.parse(tr.dataset.agent) as AgentRow; } catch { return null; }
  }

  function showToast(msg: string, type: 'success' | 'error') {
    const el = $('toast');
    el.textContent = msg;
    el.className = `toast toast-${type}`;
    el.setAttribute('aria-hidden', 'false');
    setTimeout(() => el.setAttribute('aria-hidden', 'true'), 3000);
  }

  function clearErrors() {
    document.querySelectorAll('.form-error').forEach((e) => {
      e.classList.remove('show');
      e.textContent = '';
    });
  }

  function showFieldError(id: string, msg: string) {
    const el = $(id);
    el.textContent = msg;
    el.classList.add('show');
  }

  function openCreateModal() {
    $('modal-title').textContent = 'Nuevo agente';
    ($('agent-form') as HTMLFormElement).reset();
    ($('agent-id') as HTMLInputElement).value = '';
    $('agent-slug').removeAttribute('readonly');
    $('modal-delete-btn').hidden = true;
    clearErrors();
    $('modal-overlay').hidden = false;
    $('agent-slug').focus();
  }

  function openEditModal(slug: string) {
    const a = getAgentFromRow(slug);
    if (!a) return;
    $('modal-title').textContent = 'Editar agente';
    ($('agent-id') as HTMLInputElement).value = a.slug;
    const slugInput = $('agent-slug') as HTMLInputElement;
    slugInput.value = a.slug;
    slugInput.setAttribute('readonly', 'true');
    ($('agent-name') as HTMLInputElement).value = a.name;
    ($('agent-summary') as HTMLInputElement).value = a.summary;
    ($('agent-video-url') as HTMLInputElement).value = a.video_url ?? '';
    ($('agent-video-local') as HTMLInputElement).value = a.video_local ?? '';
    ($('agent-cover') as HTMLInputElement).value = a.cover ?? '';
    ($('agent-team') as HTMLInputElement).value = (a.team ?? []).join(', ');
    ($('agent-description') as HTMLTextAreaElement).value = a.description ?? '';
    $('modal-delete-btn').hidden = false;
    clearErrors();
    $('modal-overlay').hidden = false;
    $('agent-name').focus();
  }

  function closeModal() {
    $('modal-overlay').hidden = true;
  }

  async function saveAgent() {
    const saveBtn = $('modal-save-btn') as HTMLButtonElement;
    const btnText = $('save-btn-text');
    const spinner = $('save-btn-spinner');
    saveBtn.disabled = true;
    btnText.textContent = 'Guardando…';
    spinner.style.display = 'inline-block';

    const slug = ($('agent-slug') as HTMLInputElement).value.trim();
    const teamStr = ($('agent-team') as HTMLInputElement).value.trim();
    const team = teamStr ? teamStr.split(',').map((s) => s.trim()).filter(Boolean) : [];

    const body = {
      slug,
      name: ($('agent-name') as HTMLInputElement).value.trim(),
      summary: ($('agent-summary') as HTMLInputElement).value.trim(),
      description: ($('agent-description') as HTMLTextAreaElement).value.trim(),
      team,
      video_url: ($('agent-video-url') as HTMLInputElement).value.trim() || null,
      video_local: ($('agent-video-local') as HTMLInputElement).value.trim() || null,
      cover: ($('agent-cover') as HTMLInputElement).value.trim() || null,
    };

    const editingSlug = ($('agent-id') as HTMLInputElement).value;
    const isEdit = Boolean(editingSlug);
    const url = isEdit ? `/api/agents/${encodeURIComponent(editingSlug)}` : '/api/agents';
    const method = isEdit ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });

      if (res.ok) {
        showToast(isEdit ? 'Agente actualizado' : 'Agente creado', 'success');
        window.location.reload();
        return;
      }

      const err = await res.json().catch(() => ({ error: 'Error al guardar' }));
      showToast(err.error ?? 'Error al guardar', 'error');
    } catch {
      showToast('Error de conexión', 'error');
    } finally {
      saveBtn.disabled = false;
      btnText.textContent = 'Guardar';
      spinner.style.display = 'none';
    }
  }

  function handleFormSubmit(e: Event) {
    e.preventDefault();
    clearErrors();
    const slug = ($('agent-slug') as HTMLInputElement).value.trim();
    const name = ($('agent-name') as HTMLInputElement).value.trim();
    const summary = ($('agent-summary') as HTMLInputElement).value.trim();
    let hasError = false;
    if (!slug) { showFieldError('slug-error', 'El slug es obligatorio'); hasError = true; }
    if (!name) { showFieldError('name-error', 'El nombre es obligatorio'); hasError = true; }
    if (!summary) { showFieldError('summary-error', 'El resumen es obligatorio'); hasError = true; }
    if (hasError) return;
    saveAgent();
  }

  async function handleDelete() {
    if (!window.confirm('¿Estás seguro de eliminar este agente?')) return;
    const slug = ($('agent-id') as HTMLInputElement).value;
    try {
      const res = await fetch(`/api/agents/${encodeURIComponent(slug)}`, {
        method: 'DELETE',
        credentials: 'same-origin',
      });
      if (res.ok) {
        showToast('Agente eliminado', 'success');
        window.location.reload();
        return;
      }
      const err = await res.json().catch(() => ({ error: 'Error al eliminar' }));
      showToast(err.error ?? 'Error al eliminar', 'error');
    } catch {
      showToast('Error de conexión', 'error');
    }
  }

  async function handleLogout() {
    await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
    window.location.href = '/admin/login';
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const editBtn = target.closest<HTMLElement>('.btn-edit');
    if (editBtn?.dataset.slug) {
      openEditModal(editBtn.dataset.slug);
      return;
    }
    if (target.closest('#new-agent-btn')) { openCreateModal(); return; }
    if (target.closest('#logout-btn')) { handleLogout(); return; }
    if (target.closest('#modal-close-btn') || target.closest('#cancel-btn')) {
      closeModal();
      return;
    }
    if (target.closest('#modal-delete-btn')) { handleDelete(); return; }
    if (target === $('modal-overlay')) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  ($('agent-form') as HTMLFormElement).addEventListener('submit', handleFormSubmit);
</script>
