---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';

if (isAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/dashboard');
}
---

<AdminLayout title="Iniciar sesión · Admin" showTopBar={false} withLogout={false}>
  <main class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="flex flex-col items-center mb-8">
        <img
          src="/brand/icesi-positivo.svg"
          alt="Universidad Icesi"
          width="140"
          height="40"
          class="h-12 w-auto mb-6"
        />
        <h1 class="text-2xl font-extrabold tracking-tight text-text">Panel Admin</h1>
        <p class="text-sm text-muted mt-1">Agentes de IA · Icesi</p>
      </div>

      <div class="bg-white border border-border rounded-2xl p-7 shadow-sm">
        <form id="login-form" class="space-y-4">
          <div>
            <label for="password" class="block text-xs font-semibold text-text mb-1.5">
              Contraseña
            </label>
            <input
              type="password"
              id="password"
              autocomplete="current-password"
              required
              autofocus
              class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2.5 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
            />
          </div>
          <div id="login-error" class="hidden rounded-lg border border-[#fecaca] bg-[#fef2f2] px-3 py-2 text-xs text-[#991b1b]" role="alert"></div>
          <button
            type="submit"
            id="login-submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-icesi-blue px-4 py-2.5 text-sm font-semibold text-white hover:bg-icesi-blue-deep disabled:opacity-60 disabled:cursor-not-allowed transition-colors"
          >
            <span id="login-submit-text">Ingresar</span>
            <svg id="login-spinner" class="hidden animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </main>
</AdminLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorEl = document.getElementById('login-error') as HTMLElement;
  const submit = document.getElementById('login-submit') as HTMLButtonElement;
  const submitText = document.getElementById('login-submit-text') as HTMLElement;
  const spinner = document.getElementById('login-spinner') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    submit.disabled = true;
    submitText.textContent = 'Ingresando…';
    spinner.classList.remove('hidden');

    const password = (document.getElementById('password') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ password }),
      });
      if (res.ok) {
        window.location.href = '/admin/dashboard';
        return;
      }
      errorEl.textContent = 'Contraseña incorrecta. Intentá de nuevo.';
      errorEl.classList.remove('hidden');
    } catch {
      errorEl.textContent = 'Error de conexión. Intentá de nuevo.';
      errorEl.classList.remove('hidden');
    } finally {
      submit.disabled = false;
      submitText.textContent = 'Ingresar';
      spinner.classList.add('hidden');
    }
  });
</script>
