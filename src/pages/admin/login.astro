---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';

if (isAdmin(Astro.cookies)) {
  return Astro.redirect('/admin/dashboard');
}
---

<AdminLayout title="Iniciar sesión · Admin">
  <div class="login-shell">
    <div class="login-card">
      <h1 class="login-title">Admin Panel</h1>
      <p class="login-subtitle">Ingresá la contraseña para acceder al panel de gestión.</p>
      <div id="error" class="login-error" role="alert"></div>
      <form id="login-form" class="login-form">
        <label for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        />
        <button type="submit" class="btn">Ingresar</button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorEl = document.getElementById('error') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.remove('show');
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ password }),
    });
    if (res.ok) {
      window.location.href = '/admin/dashboard';
    } else {
      errorEl.textContent = 'Contraseña incorrecta. Intentá de nuevo.';
      errorEl.classList.add('show');
    }
  });
</script>
