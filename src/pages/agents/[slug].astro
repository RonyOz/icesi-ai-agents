---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoFrame from "../../components/VideoFrame.astro";
import Cenefa from "../../components/Cenefa.astro";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, summary, description, team, videoUrl, videoLocal, cover } =
  entry.data;
---

<BaseLayout
  title={`${name} · Showcase de Agentes de IA · Icesi`}
  description={summary}
>
  <article>
    <nav aria-label="Migas de pan" class="mb-8 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-muted">
        <li>
          <a
            href={withBase("/")}
            class="font-medium hover:text-icesi-blue-deep transition-colors"
          >
            Showcase
          </a>
        </li>
        <li aria-hidden="true" class="text-icesi-gray-2">/</li>
        <li class="text-text font-medium truncate max-w-[60ch]" aria-current="page">
          {name}
        </li>
      </ol>
    </nav>

    <div class="mb-8 border border-border overflow-hidden">
      <VideoFrame
        videoUrl={videoUrl}
        videoLocal={videoLocal}
        cover={cover}
        title={name}
      />
    </div>

    <p class="eyebrow mb-3">Agente en desarrollo</p>
    <h1
      class="text-[2.25rem] sm:text-[3rem] font-extrabold leading-[1.05] tracking-tight"
    >
      {name}
    </h1>
    <p class="mt-5 text-lg text-muted leading-relaxed">
      {description}
    </p>


    <div class="mt-8">
      <Cenefa />
    </div>

    <!-- <h2 class="mt-10 text-xl font-bold tracking-tight">Descripción</h2>
    <p class="mt-3 text-[15px] leading-relaxed text-muted">
      {description}
    </p> -->

    {
      team.length > 0 && (
        <>
          <h2 class="mt-10 text-xl font-bold tracking-tight">Equipo</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-muted">
            {team.join(", ")}
          </p>
        </>
      )
    }

    <div
      class="prose prose-neutral mt-12 max-w-none prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:font-bold prose-h3:text-lg prose-h3:font-bold prose-p:text-muted prose-p:leading-relaxed prose-li:text-muted prose-strong:text-text prose-a:text-icesi-blue-deep prose-a:no-underline hover:prose-a:underline"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
