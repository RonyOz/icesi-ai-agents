---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { accentVar, statusLabel } from '../../lib/accent';

export async function getStaticPaths() {
  const agents = await getCollection('agents');
  return agents.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, summary, description, category, status, team, faculty, tags, accent, demoUrl, videoUrl } = entry.data;

const accentColor = accentVar[accent];
const statusInfo = statusLabel[status] ?? statusLabel.Idea;
---

<BaseLayout title={`${name} · Showcase de Agentes de IA · Icesi`} description={summary}>
  <article class="grid lg:grid-cols-[1fr_320px] gap-12">
    <div class="max-w-3xl">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-brand-ink)] transition-colors mb-10"
      >
        ← Volver al showcase
      </a>

      <p class="eyebrow mb-4" style={`color: ${accentColor};`}>{category}</p>

      <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-[1.08] tracking-tight">
        {name}
      </h1>
      <p class="mt-5 text-lg text-[var(--color-muted)] leading-relaxed">{summary}</p>

      <hr class="rule my-10" />

      <h2 class="font-display text-xl font-semibold mb-3 tracking-tight">Descripción</h2>
      <p class="text-[15px] leading-relaxed text-[var(--color-muted)]">{description}</p>

      {(demoUrl || videoUrl) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {demoUrl && (
            <a
              href={demoUrl}
              rel="noopener"
              class="inline-flex items-center gap-2 rounded bg-[var(--color-brand)] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[var(--color-brand-ink)] transition-colors"
            >
              Probar demo →
            </a>
          )}
          {videoUrl && (
            <a
              href={videoUrl}
              rel="noopener"
              class="inline-flex items-center gap-2 rounded border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-2.5 text-sm font-semibold text-[var(--color-text)] hover:border-[var(--color-brand)] transition-colors"
            >
              Ver grabación
            </a>
          )}
        </div>
      )}

      <div
        class="prose prose-neutral mt-12 max-w-none prose-headings:font-display prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-p:text-[var(--color-muted)] prose-p:leading-relaxed prose-li:text-[var(--color-muted)] prose-strong:text-[var(--color-text)] prose-a:text-[var(--color-brand-ink)] prose-a:no-underline hover:prose-a:underline"
      >
        <Content />
      </div>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="border border-border bg-(--color-surface)">
        <div class="border-b border-border p-5">
          <p class="text-[11px] uppercase tracking-[0.16em] text-subtle mb-2">Estado</p>
          <p class="chip" style={`color: ${statusInfo.tone};`}>
            <span class="chip-dot"></span>
            {statusInfo.label}
          </p>
        </div>
        {faculty && (
          <div class="border-b border-border p-5">
            <p class="text-[11px] uppercase tracking-[0.16em] text-subtle mb-2">Facultad</p>
            <p class="text-sm leading-relaxed">{faculty}</p>
          </div>
        )}
        {team.length > 0 && (
          <div class="border-b border-border p-5">
            <p class="text-[11px] uppercase tracking-[0.16em] text-subtle mb-2">Equipo</p>
            <p class="text-sm leading-relaxed">{team.join(', ')}</p>
          </div>
        )}
        {tags.length > 0 && (
          <div class="p-5">
            <p class="text-[11px] uppercase tracking-[0.16em] text-subtle mb-3">Áreas</p>
            <div class="flex flex-wrap gap-1.5">
              {tags.map((t) => <span class="chip">{t}</span>)}
            </div>
          </div>
        )}
      </div>
    </aside>
  </article>
</BaseLayout>
