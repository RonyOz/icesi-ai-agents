---
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-white">
  <div class="container-page py-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <img
        src={withBase('/brand/icesi-positivo.svg')}
        alt="Universidad Icesi"
        width="120"
        height="34"
        class="h-16 w-auto"
      />
    </div>
    <p class="text-xs text-muted">
      © {year} Universidad Icesi · Desarrollo de Agentes · IA
    </p>
  </div>
</footer>
