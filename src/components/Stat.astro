---
type Props = {
  label: string;
  value: number | string;
};
const { label, value } = Astro.props;
---

<div class="bg-[var(--color-surface)] p-5">
  <dt class="text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--color-subtle)]">
    {label}
  </dt>
  <dd class="mt-2 font-display text-3xl font-semibold tabular-nums text-[var(--color-text)]">
    {value}
  </dd>
</div>
