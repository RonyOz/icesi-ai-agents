---
import Cenefa from './Cenefa.astro';

type Props = {
  videoUrl?: string;
  cover?: string;
  title: string;
};

const { videoUrl, title } = Astro.props;

function youtubeId(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
  return m ? m[1] : null;
}

function vimeoId(url: string): string | null {
  const m = url.match(/vimeo\.com\/(\d+)/);
  return m ? m[1] : null;
}

function isSharePointShareLink(url: string): boolean {
  return /sharepoint\.com\/:v:\/[gp]\//i.test(url);
}

function isDirectIframe(url: string): boolean {
  if (!url) return false;
  if (isSharePointShareLink(url)) return false;
  return /sharepoint\.com.*embed\.aspx/i.test(url)
    || /web\.microsoftstream\.com\/embed/i.test(url)
    || /loom\.com\/embed/i.test(url)
    || /drive\.google\.com\/file\/d\/[\w-]+\/preview/i.test(url);
}

const yt = videoUrl ? youtubeId(videoUrl) : null;
const vm = videoUrl && !yt ? vimeoId(videoUrl) : null;
const direct = videoUrl && !yt && !vm ? isDirectIframe(videoUrl) : false;
const shareLink = videoUrl ? isSharePointShareLink(videoUrl) : false;
---

{yt ? (
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${yt}`}
    title={`Video del agente ${title}`}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    class="block w-full aspect-video bg-black"
  ></iframe>
) : vm ? (
  <iframe
    src={`https://player.vimeo.com/video/${vm}`}
    title={`Video del agente ${title}`}
    loading="lazy"
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
    class="block w-full aspect-video bg-black"
  ></iframe>
) : direct && videoUrl ? (
  <iframe
    src={videoUrl}
    title={`Video del agente ${title}`}
    loading="lazy"
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
    class="block w-full aspect-video bg-black"
  ></iframe>
) : shareLink && videoUrl ? (
  <div class="relative w-full aspect-video bg-icesi-blue-soft flex flex-col items-center justify-center gap-3 p-6 text-center">
    <p class="text-sm font-semibold text-icesi-blue-deep">
      Video alojado en SharePoint
    </p>
    <p class="text-xs text-muted max-w-md">
      Para empotrar el reproductor, usa la URL de “Copiar código de inserción”
      (formato <code>embed.aspx</code>) en lugar del enlace de compartir.
    </p>
    <a
      href={videoUrl}
      target="_blank"
      rel="noopener"
      class="mt-2 inline-flex items-center gap-2 rounded bg-icesi-blue px-4 py-2 text-sm font-semibold text-white hover:bg-icesi-blue-deep transition-colors"
    >
      Abrir video en SharePoint ↗
    </a>
  </div>
) : (
  <Cenefa variant="block" />
)}
