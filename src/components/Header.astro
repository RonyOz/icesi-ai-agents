---
import { withBase } from '../lib/url';
const { count } = Astro.props as { count?: number };
---

<header class="border-b border-border bg-white sticky top-0 z-30">
  <div class="container-page flex items-center justify-between py-3">
    <a href={withBase('/')} class="flex items-center gap-4">
      <img
        src={withBase('/brand/icesi-positivo.svg')}
        alt="Universidad Icesi"
        width="116"
        height="32"
        class="h-14 w-auto"
      />
      <span class="hidden sm:inline-block h-7 w-px bg-icesi-gray-2"></span>
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="text-[15px] font-bold tracking-tight text-text">
          Agentes en desarrollo
        </span>
        <span class="text-[11px] text-muted font-medium">
          Showcase de Proyectos · IA
        </span>
      </span>
    </a>

    {count !== undefined && (
      <span class="text-xs font-semibold text-icesi-blue">
        {count} {count === 1 ? 'agente' : 'agentes'} en desarrollo
      </span>
    )}
  </div>
</header>
