---
import type { Agent } from '../../lib/db';

type Props = { agents: Agent[] };
const { agents } = Astro.props;
---

{agents.length === 0 ? (
  <div class="empty-state" aria-live="polite">
    <p style="font-size:1.1rem;margin-bottom:0.5rem;">No hay agentes cargados.</p>
    <p style="font-size:0.875rem;">Hacé clic en &ldquo;Nuevo agente&rdquo; para crear el primero.</p>
  </div>
) : (
  <table class="agents-table">
    <caption class="sr-only">Agentes de IA</caption>
    <thead>
      <tr>
        <th scope="col">Nombre</th>
        <th scope="col">Resumen</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {agents.map((a) => (
        <tr data-agent={JSON.stringify(a)}>
          <td class="name-cell">{a.name}</td>
          <td class="summary-cell">{a.summary}</td>
          <td>
            <div class="actions">
              <button type="button" class="btn btn-ghost btn-edit" data-slug={a.slug}>
                Editar
              </button>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
)}
