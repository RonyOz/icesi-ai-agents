---
import type { Agent } from '../../lib/db';
import { colorForArea, relativeTime } from '../../lib/format';
import Cenefa from '../Cenefa.astro';

type Props = { agent: Agent };
const { agent } = Astro.props;
const areaColors = colorForArea(agent.area);
const updated = relativeTime(agent.updated_at);
---

<article
  class="admin-card group relative flex flex-col bg-[var(--color-surface)] border border-border overflow-hidden"
  data-agent={JSON.stringify(agent)}
  data-slug={agent.slug}
  data-name-search={agent.name.toLowerCase()}
  data-summary-search={agent.summary.toLowerCase()}
  data-encargado-search={(agent.encargado ?? '').toLowerCase()}
  data-area={agent.area ?? ''}
>
  <div class="card-default flex flex-col h-full">
    <div class="relative aspect-video w-full overflow-hidden bg-[var(--color-surface-2)]">
      {agent.cover ? (
        <img
          src={agent.cover}
          alt=""
          loading="lazy"
          class="block h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      ) : (
        <Cenefa variant="block" />
      )}
      {agent.video_url && (
        <span
          aria-label="Tiene video"
          class="absolute right-2 top-2 inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-0.5 text-[10px] font-semibold text-icesi-blue-deep shadow-sm"
        >
          <svg viewBox="0 0 12 12" width="9" height="9" aria-hidden="true">
            <path d="M3 2 L10 6 L3 10 Z" fill="currentColor" />
          </svg>
          Video
        </span>
      )}
    </div>

    <div class="flex flex-1 flex-col gap-2 p-4">
      {agent.area && (
        <span class={`self-start inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${areaColors.bg} ${areaColors.text}`}>
          {agent.area}
        </span>
      )}
      <h3 class="text-[15px] font-bold leading-snug tracking-tight text-text line-clamp-2">
        {agent.name}
      </h3>
      <p class="text-xs leading-relaxed text-muted line-clamp-2">{agent.summary}</p>
      {agent.encargado && (
        <p class="text-[11px] text-subtle font-medium mt-auto pt-2 truncate">
          {agent.encargado}
        </p>
      )}
      {updated && (
        <p class="text-[10px] text-icesi-gray-1">{updated}</p>
      )}
    </div>

    <div class="flex border-t border-border">
      <button
        type="button"
        class="js-edit flex-1 flex items-center justify-center gap-1.5 py-2.5 text-xs font-semibold text-muted hover:bg-[var(--color-surface-2)] hover:text-icesi-blue-deep transition-colors"
        data-slug={agent.slug}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Editar
      </button>
      <div class="w-px bg-border"></div>
      <button
        type="button"
        class="js-delete-ask flex items-center justify-center px-4 py-2.5 text-xs font-semibold text-muted hover:bg-[#fef2f2] hover:text-[#dc2626] transition-colors"
        data-slug={agent.slug}
        aria-label={`Eliminar ${agent.name}`}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
          <path d="M10 11v6M14 11v6"/>
          <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="card-confirm absolute inset-0 flex flex-col items-center justify-center gap-3 bg-white/95 backdrop-blur-sm p-6 text-center">
    <p class="text-sm font-semibold text-text">¿Eliminar este agente?</p>
    <p class="text-xs text-muted">"{agent.name}"</p>
    <div class="flex gap-2 mt-2">
      <button
        type="button"
        class="js-delete-cancel rounded border border-border bg-white px-3 py-1.5 text-xs font-semibold text-muted hover:bg-[var(--color-surface-2)]"
        data-slug={agent.slug}
      >
        Cancelar
      </button>
      <button
        type="button"
        class="js-delete-confirm rounded bg-[#dc2626] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#b91c1c]"
        data-slug={agent.slug}
      >
        Sí, eliminar
      </button>
    </div>
  </div>
</article>
