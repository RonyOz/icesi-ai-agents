---
---

<div
  id="panel-backdrop"
  class="admin-backdrop fixed inset-0 z-40 bg-black/40"
  data-open="false"
  aria-hidden="true"
></div>

<aside
  id="form-panel"
  class="admin-panel fixed inset-y-0 right-0 z-50 w-full max-w-[520px] bg-white border-l border-border shadow-2xl flex flex-col"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-labelledby="panel-title"
  aria-hidden="true"
>
  <header class="flex items-center justify-between px-6 py-4 border-b border-border">
    <h2 id="panel-title" class="text-base font-bold tracking-tight">Nuevo agente</h2>
    <button
      type="button"
      id="panel-close"
      class="rounded p-1.5 text-muted hover:bg-[var(--color-surface-2)] hover:text-text"
      aria-label="Cerrar"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </header>

  <form id="agent-form" class="flex flex-col flex-1 min-h-0" novalidate>
    <div class="flex-1 overflow-y-auto px-6 py-5 space-y-5">
      <input type="hidden" id="agent-original-slug" />

      <div>
        <label for="agent-name" class="block text-xs font-semibold text-text mb-1.5">
          Nombre del proyecto <span class="text-[#dc2626]" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="agent-name"
          required
          placeholder="Agente consultor de…"
          autocomplete="off"
          class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
        />
        <p class="form-error hidden text-[11px] text-[#dc2626] mt-1" id="name-error" role="alert"></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="agent-area" class="block text-xs font-semibold text-text mb-1.5">Área</label>
          <input
            type="text"
            id="agent-area"
            placeholder="Posgrados"
            autocomplete="off"
            list="areas-suggestions"
            class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
          />
        </div>
        <div>
          <label for="agent-encargado" class="block text-xs font-semibold text-text mb-1.5">Encargado</label>
          <input
            type="text"
            id="agent-encargado"
            placeholder="Nombre del encargado"
            autocomplete="off"
            class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
          />
        </div>
      </div>

      <div>
        <label for="agent-summary" class="block text-xs font-semibold text-text mb-1.5">
          Resumen
        </label>
        <input
          type="text"
          id="agent-summary"
          placeholder="Breve descripción visible en la tarjeta"
          autocomplete="off"
          class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
        />
      </div>

      <div>
        <label for="agent-description" class="block text-xs font-semibold text-text mb-1.5">
          Descripción del impacto
        </label>
        <textarea
          id="agent-description"
          rows="4"
          placeholder="Detalle del impacto del agente…"
          class="w-full resize-y min-h-[100px] rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
        ></textarea>
      </div>

      <details class="group rounded-lg border border-border bg-[var(--color-surface-2)] open:bg-white open:border-icesi-blue/30">
        <summary class="flex cursor-pointer items-center justify-between gap-2 px-4 py-3 text-xs font-semibold text-text list-none">
          <span>Más detalles (slug, cover, video)</span>
          <svg class="transition-transform group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="px-4 pb-4 pt-2 space-y-4">
          <div>
            <label for="agent-slug" class="block text-xs font-semibold text-text mb-1.5">
              Slug <span class="font-normal text-muted">(URL: /agents/[slug]/)</span>
            </label>
            <input
              type="text"
              id="agent-slug"
              required
              placeholder="se genera automáticamente"
              autocomplete="off"
              spellcheck="false"
              class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm font-mono focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
            />
            <p class="form-error hidden text-[11px] text-[#dc2626] mt-1" id="slug-error" role="alert"></p>
          </div>

          <div>
            <label for="agent-cover" class="block text-xs font-semibold text-text mb-1.5">
              Cover (URL de imagen)
            </label>
            <input
              type="url"
              id="agent-cover"
              placeholder="https://…/imagen.jpg"
              autocomplete="off"
              class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
            />
            <div id="cover-preview" class="mt-2 hidden aspect-video w-full overflow-hidden rounded-lg border border-border bg-[var(--color-surface-2)]">
              <img id="cover-preview-img" src="" alt="" class="block h-full w-full object-cover" />
            </div>
          </div>

          <div>
            <label for="agent-video-url" class="block text-xs font-semibold text-text mb-1.5">
              Video URL
            </label>
            <input
              type="url"
              id="agent-video-url"
              placeholder="https://youtube.com/…"
              autocomplete="off"
              class="w-full rounded-lg border-[1.5px] border-border bg-white px-3 py-2 text-sm focus:border-icesi-blue focus:outline-none focus:ring-3 focus:ring-icesi-blue/15"
            />
          </div>
        </div>
      </details>
    </div>

    <footer class="flex items-center justify-end gap-2 px-6 py-4 border-t border-border bg-white">
      <button
        type="button"
        id="panel-cancel"
        class="rounded-lg border border-border bg-white px-4 py-2 text-sm font-semibold text-muted hover:bg-[var(--color-surface-2)]"
      >
        Cancelar
      </button>
      <button
        type="submit"
        id="panel-save"
        class="inline-flex items-center gap-2 rounded-lg bg-icesi-blue px-4 py-2 text-sm font-semibold text-white hover:bg-icesi-blue-deep disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span id="panel-save-text">Guardar</span>
        <svg id="panel-save-spinner" class="hidden animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round"/>
        </svg>
      </button>
    </footer>
  </form>
</aside>

<datalist id="areas-suggestions"></datalist>
